# Copie este arquivo para ".env" (uso local) ou configure estas mesmas
# variáveis no painel da sua hospedagem (Railway, Render, etc.)

PORT=3000

# String de conexão do PostgreSQL de produção (Neon, Supabase, Railway, RDS...)
DATABASE_URL=postgresql://usuario:senha@host:5432/impasto_moreira

# Desative apenas se o Postgres for local sem SSL. Em produção deixe "true".
PGSSL=true

# Gere uma chave longa e aleatória, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Domínio do seu cardápio público, para restringir o CORS. Use "*" em testes.
CORS_ORIGIN=https://seudominio.com.br

# Usados apenas uma vez, ao rodar "npm run seed:admin" para criar o administrador
ADMIN_NAME=Seu Nome
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=defina-uma-senha-forte
